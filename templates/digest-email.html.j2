<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ subject }}</title>
</head>
<body style="margin:0; padding:0; background:#f4f4f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; color:#1f2937; line-height:1.5;">

<!-- Preheader (versteckter Anreißer im Email-Client) -->
<div style="display:none; max-height:0; overflow:hidden; opacity:0;">
  {{ preheader }}
</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f5; padding:24px 0;">
<tr>
<td align="center">

  <table role="presentation" width="640" cellpadding="0" cellspacing="0" style="max-width:640px; width:100%; background:#ffffff; border:1px solid #e5e7eb; border-radius:8px; overflow:hidden;">

    <!-- Header -->
    <tr>
      <td style="background:#0f172a; padding:28px 32px; color:#f8fafc;">
        <div style="font-size:13px; color:#94a3b8; letter-spacing:0.08em; text-transform:uppercase; margin-bottom:6px;">News-Digest</div>
        <div style="font-size:24px; font-weight:700; line-height:1.2;">{{ subject }}</div>
        <div style="font-size:13px; color:#cbd5e1; margin-top:8px;">{{ date_human }} · {{ total_articles }} Artikel aus {{ sources_count }} Quellen</div>
      </td>
    </tr>

    <!-- Stats -->
    <tr>
      <td style="padding:20px 32px; background:#f8fafc; border-bottom:1px solid #e5e7eb;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
          <tr>
            {% for t in topic_stats %}
            <td align="center" style="padding:6px;">
              <div style="font-size:22px; font-weight:700; color:{{ t.color }};">{{ t.count }}</div>
              <div style="font-size:11px; color:#64748b; text-transform:uppercase; letter-spacing:0.05em;">{{ t.label }}</div>
            </td>
            {% endfor %}
          </tr>
        </table>
      </td>
    </tr>

    <!-- Topic Sections -->
    {% for section in sections %}
    <tr>
      <td style="padding:28px 32px 8px 32px;">
        <div style="border-left:4px solid {{ section.color }}; padding-left:12px;">
          <div style="font-size:18px; font-weight:700; color:#0f172a;">{{ section.emoji }} {{ section.label }}</div>
          <div style="font-size:12px; color:#64748b; margin-top:2px;">{{ section.count }} Artikel</div>
        </div>
      </td>
    </tr>

    {% for art in section.articles %}
    <tr>
      <td style="padding:14px 32px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-left:2px solid #e5e7eb; padding-left:14px;">
          <tr>
            <td>
              <div style="font-size:11px; color:#64748b; margin-bottom:4px;">
                <span style="background:#f1f5f9; padding:2px 8px; border-radius:4px; font-weight:600;">★ {{ art.importance }}/5</span>
                <span style="margin-left:6px;">{{ art.source }}</span>
                {% if art.published %}
                <span style="margin-left:6px;">· {{ art.published }}</span>
                {% endif %}
              </div>
              <div style="font-size:16px; font-weight:600; color:#0f172a; margin-bottom:6px;">
                <a href="{{ art.url }}" style="color:#0f172a; text-decoration:none;">{{ art.title }}</a>
              </div>
              {% if art.summary_de %}
              <div style="font-size:14px; color:#374151; line-height:1.55;">{{ art.summary_de }}</div>
              {% endif %}
            </td>
          </tr>
        </table>
      </td>
    </tr>
    {% endfor %}

    {% if not loop.last %}
    <tr>
      <td style="padding:0 32px;">
        <div style="border-top:1px solid #e5e7eb;"></div>
      </td>
    </tr>
    {% endif %}
    {% endfor %}

    <!-- Footer -->
    <tr>
      <td style="padding:24px 32px; background:#f8fafc; border-top:1px solid #e5e7eb;">
        <div style="font-size:12px; color:#64748b; line-height:1.6;">
          <div style="margin-bottom:6px;">
            Generiert am {{ generated_at }} · Modul 3 (news-digest Pipeline)
          </div>
          <div>
            Quellen:
            {% for s in sources %}<span style="color:#475569;">{{ s.source }}</span>{% if not loop.last %}, {% endif %}{% endfor %}
          </div>
        </div>
      </td>
    </tr>

  </table>

  <div style="font-size:11px; color:#94a3b8; padding:16px 32px; max-width:640px;">
    News-Digest · {{ date_iso }}
  </div>

</td>
</tr>
</table>
</body>
</html>
